<% if (plugins.letterboxd) { %>
  <section>
    <h2 class="field">
      <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 16 16" width="16" height="16"><path fill-rule="evenodd" d="M16 3.75a.75.75 0 00-1.136-.643L11 5.425V4.75A1.75 1.75 0 009.25 3h-7.5A1.75 1.75 0 000 4.75v6.5C0 12.216.784 13 1.75 13h7.5A1.75 1.75 0 0011 11.25v-.675l3.864 2.318A.75.75 0 0016 12.25v-8.5zm-5 5.075l3.5 2.1v-5.85l-3.5 2.1v1.65zM9.5 6.75v-2a.25.25 0 00-.25-.25h-7.5a.25.25 0 00-.25.25v6.5c0 .138.112.25.25.25h7.5a.25.25 0 00.25-.25v-4.5z"></path></svg>
      Letterboxd (Recent Watches)
    </h2>
    <% if (plugins.letterboxd.error) { %>
      <div class="row">
        <section>
          <div class="field error">
            <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 16 16" width="16" height="16"><path fill-rule="evenodd" d="M2.343 13.657A8 8 0 1113.657 2.343 8 8 0 012.343 13.657zM6.03 4.97a.75.75 0 00-1.06 1.06L6.94 8 4.97 9.97a.75.75 0 101.06 1.06L8 9.06l1.97 1.97a.75.75 0 101.06-1.06L9.06 8l1.97-1.97a.75.75 0 10-1.06-1.06L8 6.94 6.03 4.97z"></path></svg>
            <%= plugins.letterboxd.error.message %>
          </div>
        </section>
      </div>
    <% } else { %>
      <div class="row fill-width">
        <section>
          <div class="letterboxd">
            <div class="medias largeable-flex-wrap">
              <% for (const item of plugins.letterboxd.feed) { %>
                <div class="media largeable-width-half" style="margin-bottom: 12px; display: flex;">
                  <% if (item.image) { %>
                    <img src="<%= item.image %>" width="48" height="72" alt="" style="margin-right: 8px;" />
                  <% } else { %>
                    <div style="width:48px;height:72px;background:#eee;margin-right:8px;"></div>
                  <% } %>
                  <div class="about" style="flex: 1; overflow: hidden; white-space: nowrap; text-overflow: ellipsis;">
                    <div class="name" style="font-weight: 600; font-size: 14px;">
                      <%= item.title %> <%= item.year ? `(${item.year})` : "" %>
                    </div>
                    <div class="infos" style="font-size: 12px; margin-top: 4px;">
                      <% if (item.rating) { %>
                        <div style="color: #f5b50a;">
                          <% for(let i=0; i<Math.floor(item.rating); i++) { %>★<% } %>
                          <% if(item.rating % 1 !== 0) { %>½<% } %>
                        </div>
                      <% } else { %>
                        <div style="color: #888;">No rating</div>
                      <% } %>
                    </div>
                  </div>
                </div>
              <% } %>
            </div>
          </div>
        </section>
      </div>
    <% } %>
  </section>
<% } %>
