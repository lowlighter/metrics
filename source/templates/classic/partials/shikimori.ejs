    check:"M1.5 8a6.5 6.5 0 1113 0 6.5 6.5 0 01-13 0zM0 8a8 8 0 1116 0A8 8 0 010 8zm11.78-1.72a.75.75 0 00-1.06-1.06L6.75 9.19 5.28 7.72a.75.75 0 00-1.06 1.06l2 2a.75.75 0 001.06 0l4.5-4.5z",
    play:"M1.5 8a6.5 6.5 0 1113 0 6.5 6.5 0 01-13 0zM8 0a8 8 0 100 16A8 8 0 008 0zM6.379 5.227A.25.25 0 006 5.442v5.117a.25.25 0 00.379.214l4.264-2.559a.25.25 0 000-.428L6.379 5.227z",
    info:"M8 1.5a6.5 6.5 0 100 13 6.5 6.5 0 000-13zM0 8a8 8 0 1116 0A8 8 0 010 8zm6.5-.25A.75.75 0 017.25 7h1a.75.75 0 01.75.75v2.75h.25a.75.75 0 010 1.5h-2a.75.75 0 010-1.5h.25v-2h-.25a.75.75 0 01-.75-.75zM8 6a1 1 0 100-2 1 1 0 000 2z",
    heart:"M4.25 2.5c-1.336 0-2.75 1.164-2.75 3 0 2.15 1.58 4.144 3.365 5.682A20.565 20.565 0 008 13.393a20.561 20.561 0 003.135-2.211C12.92 9.644 14.5 7.65 14.5 5.5c0-1.836-1.414-3-2.75-3-1.373 0-2.609.986-3.029 2.456a.75.75 0 01-1.442 0C6.859 3.486 5.623 2.5 4.25 2.5zM8 14.25l-.345.666-.002-.001-.006-.003-.018-.01a7.643 7.643 0 01-.31-.17 22.075 22.075 0 01-3.434-2.414C2.045 10.731 0 8.35 0 5.5 0 2.836 2.086 1 4.25 1 5.797 1 7.153 1.802 8 3.02 8.847 1.802 10.203 1 11.75 1 13.914 1 16 2.836 16 5.5c0 2.85-2.045 5.231-3.885 6.818a22.08 22.08 0 01-3.744 2.584l-.018.01-.006.003h-.002L8 14.25zm0 0l.345.666a.752.752 0 01-.69 0L8 14.25z",
    trophy:"M4 1.75C4 .784 4.784 0 5.75 0h4.5C11.216 0 12 .784 12 1.75V3h1.5A2.5 2.5 0 0 1 16 5.5v.75a3.75 3.75 0 0 1-3.218 3.712A4.25 4.25 0 0 1 9 12.87V14h2.25a.75.75 0 0 1 0 1.5h-6.5a.75.75 0 0 1 0-1.5H7v-1.13a4.25 4.25 0 0 1-3.782-2.908A3.75 3.75 0 0 1 0 6.25V5.5A2.5 2.5 0 0 1 2.5 3H4V1.75ZM5.5 3h5V1.75a.25.25 0 0 0-.25-.25h-4.5a.25.25 0 0 0-.25.25V3ZM2.5 4.5a1 1 0 0 0-1 1v.75c0 1.077.778 1.974 1.804 2.155A4.237 4.237 0 0 1 3.5 6.75V4.5H2.5Zm11 1.75V5.5a1 1 0 0 0-1-1h-1v2.25c.068.583.136 1.15.196 1.655A2.25 2.25 0 0 0 13.5 6.25ZM8 11.5a2.75 2.75 0 1 0 0-5.5 2.75 2.75 0 0 0 0 5.5Z",
    chart:"M1.5 1.75V13.5h13.75a.75.75 0 0 1 0 1.5H.75a.75.75 0 0 1-.75-.75V1.75a.75.75 0 0 1 1.5 0Zm14.28 2.53-5.25 5.25a.75.75 0 0 1-1.06 0L7 7.06 4.28 9.78a.751.751 0 0 1-1.042-.018.751.751 0 0 1-.018-1.042l3.25-3.25a.75.75 0 0 1 1.06 0L10 7.94l4.72-4.72a.751.751 0 0 1 1.042.018.751.751 0 0 1 .018 1.042Z",
    tv:"M1.75 2.5h12.5c.966 0 1.75.784 1.75 1.75v7.5A1.75 1.75 0 0 1 14.25 13.5H1.75A1.75 1.75 0 0 1 0 11.75v-7.5C0 3.284.784 2.5 1.75 2.5Zm0 1.5a.25.25 0 0 0-.25.25v7.5c0 .138.112.25.25.25h12.5a.25.25 0 0 0 .25-.25v-7.5a.25.25 0 0 0-.25-.25H1.75ZM6 5.5l5 2.5-5 2.5V5.5Z",
    clock:"M8 0a8 8 0 1 1 0 16A8 8 0 0 1 8 0ZM1.5 8a6.5 6.5 0 1 0 13 0 6.5 6.5 0 0 0-13 0Zm7-3.25v3.318l2.22 1.332a.75.75 0 0 1-.77 1.284L7.25 9.25A.75.75 0 0 1 7 8.6V4.75a.75.75 0 0 1 1.5 0Z",
  }; const icon = name => `<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 16 16" width="16" height="16" aria-hidden="true"><path fill-rule="evenodd" d="${icons[name]}"></path></svg>` %>
  <section>
    <h2 class="field"><%- icon("bookmark") %>Shikimori</h2>
    <% if (plugins.shikimori.error) { %>
      <div class="row">
        <section>
          <div class="field error"><%- icon("error") %><%= plugins.shikimori.error.message %></div>
        </section>
      </div>
    <% } else { %>
      <% const {sections, lists, favorites, characters, people, stats, achievements, genres} = plugins.shikimori;
        const card_fields = ["cover", "title", "description", "score", "user_score", "progress", "year", "status", "genres", "studio", "type"];
        const fields = (module, defaulted, allowed = defaulted) => {
          let value = q[`plugin.shikimori.display.${module}`] ?? q[`shikimori.display.${module}`] ?? q[`plugin_shikimori_display_${module}`] ?? defaulted.join(",");
          try { value = decodeURIComponent(value) } catch { value = defaulted.join(",") }
          return value.split(",").map(value => value.trim().toLowerCase()).filter(value => allowed.includes(value));
        };
        const display = {
          favorites:fields("favorites", ["cover", "title", "description", "score", "year", "status", "genres", "type"], card_fields),
          lists:fields("lists", ["cover", "title", "description", "score", "user_score", "progress", "year", "status", "genres", "type"], card_fields),
          characters:fields("characters", ["name", "artwork"]), people:fields("people", ["name", "artwork"]),
          stats:fields("stats", ["summary", "statuses", "distribution", "activity"]), achievements:fields("achievements", ["icons", "chips"]),
        };
        const height = (value, max, pixels) => value ? Math.max(1, Math.round(value / max * pixels)) : 0;
      %>
      <% if (sections.includes("genres") && genres.length) { %>
        <div class="row fill-width">
          <section><div class="field"><%- icon("tag") %>Favorites genres: <%= genres.join(", ") %></div></section>
        </div>
      <% } %>
      <% if (sections.includes("stats") && (display.stats.includes("summary") || display.stats.includes("statuses") || !display.stats.length)) { %>
        <div class="row fill-width">
          <section>
            <div class="shikimori">
              <h2 class="field"><%- icon("list") %>Statistics</h2>
              <% if (display.stats.includes("summary") && stats.summary) { %>
                <div class="field wrap summary">
                  <%- icon("video") %><span><%= f(stats.summary.episodes) %> episode<%= s(stats.summary.episodes) %> watched /</span>
                  <%- icon("book") %><span><%= f(stats.summary.chapters) %> chapter<%= s(stats.summary.chapters) %> read</span>
                </div>
              <% } %>
              <% if (display.stats.includes("statuses") && stats.statuses.length) { %>
                <div class="statuses">
                  <% for (const {name, value} of stats.statuses) { %>
                    <div class="chip"><span class="name"><%= name %></span><span class="value"><%= f(value) %></span></div>
                  <% } %>
                </div>
              <% } %>
            </div>
          </section>
        </div>
      <% } %>
      <div class="row fill-width">
        <section>
          <% const blocks = [];
            if (sections.includes("lists")) {
              for (const [media, statuses] of Object.entries(lists)) {
                for (const [status, entries] of Object.entries(statuses)) {
                  if (entries.length) blocks.push({entries, fields:display.lists, header:{planned:"Planned", watching:media === "anime" ? "Currently watching" : "Currently reading", rewatching:media === "anime" ? "Currently rewatching" : "Currently rereading", completed:"Completed", on_hold:"On hold", dropped:"Dropped"}[status]});
                }
              }
            }
            if (sections.includes("favorites")) {
              for (const [media, entries] of Object.entries(favorites)) {
                if (entries.length) blocks.push({entries, fields:display.favorites, header:`Favorites ${media}s`});
              }
            }
          %>
          <% for (const {header, entries, fields} of blocks) { %>
            <div class="shikimori">
              <h2 class="field"><%- icon("list") %><%= header %></h2>
              <% if (fields.length) { %>
                <div class="medias largeable-flex-wrap">
                  <% for (const {name, type, description, release, status, genres, studio, scores, progress, volumes, released, artwork} of entries) { %>
                    <div class="media largeable-width-half">
                      <% if (fields.includes("cover") && artwork) { %>
                        <img src="<%= artwork %>" width="48" height="72" alt="<%= fields.includes("title") ? name : "" %>"/>
                      <% } %>
                      <div class="about">
                        <% if (fields.includes("title")) { %><div class="name"><%= name %></div><% } %>
                        <div class="infos">
                          <% if (fields.includes("type")) { %>
                            <div class="type"><%- icon(type === "ANIME" ? "video" : "book") %><%= type === "ANIME" ? "Anime" : "Manga" %></div>
                          <% } %>
                          <% if (fields.includes("year") || fields.includes("status")) { %>
                            <div class="release">
                              <%- icon("calendar") %><%= [fields.includes("year") ? release : null, fields.includes("status") ? {anons:"Not yet released", ongoing:"(releasing)", released:""}[status] : null].filter(value => value !== null && value !== undefined && value !== "").join(" ") %>
                            </div>
                          <% } %>
                          <% if (fields.includes("score") && scores.community !== null && scores.community !== undefined) { %>
                            <div class="score"><%- icon("score") %><%= scores.community %></div>
                          <% } %>
                          <% if (fields.includes("user_score") && scores.user !== null && scores.user !== undefined) { %>
                            <div class="user-score"><%- icon("score") %>User <%= scores.user %></div>
                          <% } %>
                          <% if (fields.includes("progress")) { %>
                            <% if (Number.isFinite(progress)) { %>
                              <div class="progress"><%- icon(progress === released ? "check" : "play") %><%= type === "ANIME" ? "Episode" : "Chapter" %> <%= progress %><%= released ? `/${released}` : "" %></div>
                            <% } else if (Number.isFinite(released)) { %>
                              <div class="progress"><%- icon("info") %><%= released %> <%= type === "ANIME" ? `episode${s(released)}` : `chapter${s(released)}` %></div>
                            <% } %>
                            <% if (type === "MANGA" && Number.isFinite(volumes)) { %>
                              <div class="volumes"><%- icon("book") %><%= volumes %> volume<%= s(volumes) %></div>
                            <% } %>
                          <% } %>
                        </div>
                        <div class="infos">
                          <% if (fields.includes("genres") && genres.length) { %><div class="genres"><%- icon("tag") %><%= genres.join(", ") %></div><% } %>
                          <% if (fields.includes("studio") && studio) { %><div class="studio"><%- icon("video") %><%= studio %></div><% } %>
                        </div>
                        <% if (fields.includes("description")) { %><div class="description"><%= description %></div><% } %>
                      </div>
                    </div>
                  <% } %>
                </div>
              <% } %>
            </div>
          <% } %>
          <% const strips = [];
            if (sections.includes("characters") && characters.length) strips.push({header:"Favorites characters", entries:characters, fields:display.characters});
            if (sections.includes("people")) {
              for (const [kind, entries] of Object.entries(people)) if (entries.length) strips.push({header:`Favorites ${kind}`, entries, fields:display.people});
            }
          %>
          <% for (const {header, entries, fields} of strips) { %>
            <div class="shikimori">
              <h2 class="field"><%- icon("heart") %><%= header %></h2>
              <div class="characters">
                <% for (const {name, artwork} of entries) { %>
                  <% if (fields.includes("artwork") && artwork) { %>
                    <img src="<%= artwork %>" width="36" height="54" alt="<%= fields.includes("name") ? name : "" %>" <% if (fields.includes("name")) { %>title="<%= name %>"<% } %>/>
                  <% } else if (fields.includes("name")) { %>
                    <span class="field name"><%= name %></span>
                  <% } %>
                <% } %>
              </div>
            </div>
          <% } %>
          <% if (sections.includes("stats") && (display.stats.includes("distribution") || display.stats.includes("activity"))) { %>
            <div class="shikimori">
              <h2 class="field"><%- icon("chart") %>Statistics</h2>
              <div class="stats-block">
                <% if (display.stats.includes("distribution")) { %>
                  <div class="histograms">
                    <% for (const media of ["anime", "manga"]) { const counts = Array.from({length:10}, (_, index) => stats.scores[media].filter(({name}) => Number(name) === index + 1).reduce((total, {value}) => total + value, 0)); const max = Math.max(0, ...counts) %>
                      <div class="histogram">
                        <div class="series-label"><%- icon(media === "anime" ? "tv" : "book") %><%= media === "anime" ? "Anime" : "Manga" %></div>
                        <div class="bars">
                          <% for (const [bucket, value] of counts.entries()) { %><div class="bar" style="height:<%= height(value, max, 24) %>px" title="<%= bucket + 1 %>: <%= value %>"></div><% } %>
                        </div>
                        <div class="bucket-labels"><% for (let bucket = 1; bucket <= 10; bucket++) { %><span><%= bucket %></span><% } %></div>
                      </div>
                    <% } %>
                  </div>
                <% } %>
                <% if (display.stats.includes("activity") && stats.activity.length) { const max = Math.max(0, ...stats.activity.map(({value}) => value)) %>
                  <div class="activity">
                    <div class="series-label"><%- icon("clock") %>Activity</div>
                    <div class="bars"><% for (const {from, to, value} of stats.activity) { %><div class="bar" style="height:<%= height(value, max, 16) %>px" title="<%= from %>–<%= to %>: <%= value %>"></div><% } %></div>
                  </div>
                <% } %>
              </div>
            </div>
          <% } %>
          <% if (sections.includes("achievements")) { %>
            <div class="shikimori">
              <h2 class="field"><%- icon("trophy") %>Achievements</h2>
              <% for (const variant of ["icons", "chips"].filter(variant => display.achievements.includes(variant))) { %>
                <div class="achievements">
                  <% for (const {name, neko_id, level, progress, icon:artwork} of achievements) { %>
                    <% if (variant === "icons" && artwork) { %>
                      <img class="badge" src="<%= artwork %>" width="26" height="26" alt="<%= name ?? neko_id %> · Lv <%= level %> · <%= progress %>%" title="<%= name ?? neko_id %> · Lv <%= level %> · <%= progress %>%"/>
                    <% } else if (variant === "chips" || !display.achievements.includes("chips")) { %>
                      <div class="badge chip-only"><span><%= name ?? neko_id %></span><span class="dot">·</span><span class="level">Lv <%= level %></span><span class="dot">·</span><span><%= progress %>%</span></div>
                    <% } %>
                  <% } %>
                </div>
              <% } %>
            </div>
          <% } %>
        </section>
      </div>
    <% } %>
  </section>
<% } %>
